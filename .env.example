# Supabase session pooler connection (port 5432) for the running API.
DATABASE_URL="postgresql://postgres.<project-ref>:<database-password>@<region>.pooler.supabase.com:5432/postgres"
# Supabase direct database connection for Prisma schema operations (may require IPv6).
DIRECT_URL="postgresql://postgres:<database-password>@db.<project-ref>.supabase.co:5432/postgres"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
PORT=3001
FRONTEND_ORIGIN="http://localhost:5173,http://localhost:8443,http://localhost:8444"
API_TARGET="http://localhost:3001"
