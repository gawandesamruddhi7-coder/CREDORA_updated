generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String         @id @default(cuid())
  fullName       String
  email          String         @unique
  phone          String?
  passwordHash   String
  age            Int?
  city           String?
  employmentType String?
  dependents     Int?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  income         Income?
  expense        Expense?
  loans          Loan[]
  scores         Score[]
  loanScenarios  LoanScenario[]

  @@index([createdAt])
}

model Income {
  id                 String @id @default(cuid())
  userId             String @unique
  monthlyIncome      Float  @default(0)
  otherMonthlyIncome Float  @default(0)
  annualIncome       Float  @default(0)
  user               User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Expense {
  id             String @id @default(cuid())
  userId         String @unique
  rent           Float  @default(0)
  utilities      Float  @default(0)
  food           Float  @default(0)
  transportation Float  @default(0)
  insurance      Float  @default(0)
  otherExpenses  Float  @default(0)
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Loan {
  id                    String   @id @default(cuid())
  userId                String
  loanType              String
  loanName              String
  principalAmount       Float
  outstandingAmount     Float
  interestRate          Float
  originalTenureMonths  Int
  remainingTenureMonths Int
  monthlyEmi            Float
  startDate             DateTime
  status                String   @default("ACTIVE")
  missedPayments        Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@index([userId, startDate])
}

model Score {
  id                     String   @id @default(cuid())
  userId                 String
  score                  Int
  paymentHistoryScore    Int
  creditUtilisationScore Int
  debtBurdenScore        Int
  creditHistoryScore     Int
  recentActivityScore    Int
  calculatedAt           DateTime @default(now())
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, calculatedAt])
}

model LoanScenario {
  id                        String   @id @default(cuid())
  userId                    String
  name                      String
  loanType                  String
  loanAmount                Float
  interestRate              Float
  tenureMonths              Int
  processingFee             Float
  calculatedEmi             Float
  projectedScore            Int
  projectedDti              Float
  projectedDisposableIncome Float
  createdAt                 DateTime @default(now())
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
